# PostgreSQL server
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laporsekolaherapor
DB_USER=postgres
DB_PASSWORD=change-me

# Backend-only secrets. Never put these in Flutter/lib or assets.
JWT_SECRET=replace-with-a-random-64-character-secret
ONESIGNAL_APP_ID=replace-with-onesignal-app-id
ONESIGNAL_REST_API_KEY=replace-with-onesignal-rest-api-key

# Origin yang boleh akses API dari browser (pisahkan koma).
# Flutter web dev default: http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Dipakai script backend/create-admin.js (password min 12 karakter)
ADMIN_EMAIL=admin@sekolah.local
ADMIN_PASSWORD=change-me-min-12-chars

PORT=3000
